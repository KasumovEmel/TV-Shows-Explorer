{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import"],
  "jsPlugins": ["./scripts/oxlint/project-rules.mjs"],
  "options": { "typeAware": true, "typeCheck": true },
  "rules": {
    "import/default": "off",
    "import/namespace": "off",
    "max-lines": ["error", { "max": 120, "skipBlankLines": false, "skipComments": false }],
    "curly": ["error", "all"],
    "project/no-nested-ternary": "error",
    "project/require-request-catch": "error",
    "typescript/no-floating-promises": ["error", { "ignoreVoid": true, "checkThenables": true }],
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "project/require-shared-request": "error",
        "project/require-request-catch": "off",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "axios",
                "importNames": ["default", "Axios", "create", "getAdapter"],
                "allowTypeImports": true,
                "message": "Для запросов используй request() из @/app/utils/request."
              }
            ],
            "patterns": [
              {
                "group": ["axios/**"],
                "allowTypeImports": true,
                "message": "Для запросов используй request() из @/app/utils/request."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/utils/request.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "project/require-shared-request": "off",
        "project/require-request-catch": "error"
      }
    }
  ],
  "ignorePatterns": ["dist/"]
}
