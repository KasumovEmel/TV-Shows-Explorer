{
  "name": "@season-one/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --platform=node --target=node24 --format=esm --bundle --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "unit": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.18",
    "htmlparser2": "12.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
