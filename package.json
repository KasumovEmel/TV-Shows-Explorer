{
  "name": "tv-shows-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "python3 .githooks/install.py",
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "turbo run build --filter=\"./apps/*\"",
    "preview": "pnpm --filter @season-one/web preview",
    "test:shell": "pnpm --filter @season-one/web test:shell",
    "lint": "oxlint --type-aware --deny-warnings .",
    "typecheck": "turbo run typecheck --filter=\"./apps/*\"",
    "format": "node scripts/format-project.mjs --write && node scripts/check-lines.mjs",
    "format:check": "node scripts/format-project.mjs --check && node scripts/check-lines.mjs",
    "check": "turbo run format:check test:formatter lint typecheck api:check",
    "test": "turbo run browser",
    "api:generate": "orval",
    "api:check": "node scripts/check-generated.mjs",
    "test:unit": "turbo run unit",
    "test:formatter": "node --test \"tests/formatter*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/js-api": "6.1.0",
    "@biomejs/wasm-nodejs": "2.6.7",
    "@fission-ai/openspec": "2.0.0",
    "@types/node": "^22.20.5",
    "orval": "8.48.0",
    "oxc-parser": "0.158.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@12.18.0"
}
