{
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript",
  "workbench.editor.customLabels.enabled": true,
  "workbench.editor.customLabels.patterns": {
    "**/index.{ts,tsx,js,jsx}": "${dirname}/index",
    "**/usePresenter.{ts,tsx,js,jsx}": "${dirname}/usePresenter",
    "**/styles.module.css": "${dirname}/styles"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "oxc.lint.customization": {
    "import/newline-after-import": { "autofix": false }
  },
  "editor.formatOnSave": true,
  "[javascript][javascriptreact][typescript][typescriptreact]": {
    "editor.defaultFormatter": "webfreak.advanced-local-formatters",
    "editor.formatOnSaveMode": "file"
  },
  "advancedLocalFormatters.formatters": [
    {
      "languages": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
      "command": ["node", "scripts/format-source.mjs", "--stdin", "$relativeFilePath"]
    }
  ],
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.fixAll.oxc": "explicit"
  }
}
